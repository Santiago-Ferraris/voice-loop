<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rendered by install.sh: __LABEL__, __RUNTIME__, __HOME__ and __STATE_DIR__
  are substituted and the result is written to ~/Library/LaunchAgents/.

  __LABEL__ is `com.voiceloop.daemon` unless VOICE_LOOP_LABEL says otherwise.
  It is a variable for one reason: `launchctl` addresses agents by label in
  `gui/$UID`, a domain that does **not** follow $HOME. A test suite that
  installs into a throwaway HOME therefore still boots the *real* agent out —
  which is exactly what happened, three times, to a machine somebody was
  using. Tests set their own label so a stray `bootout` cannot reach it.

  __RUNTIME__ is the installed copy under ~/.local/share/voice-loop, never the
  git clone: macOS TCC keeps LaunchAgents out of ~/Documents, ~/Desktop and
  ~/Downloads, and launchd cannot even execute a wrapper that lives in one of
  them ("Operation not permitted", exit 126). The renderer refuses to write a
  plist that names a protected path.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__RUNTIME__/bin/voice-loopd</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__RUNTIME__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__STATE_DIR__/logs/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__STATE_DIR__/logs/stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a bare PATH; `say`, `afplay` and osascript live in
         /usr/bin, Homebrew tools in /opt/homebrew/bin. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
